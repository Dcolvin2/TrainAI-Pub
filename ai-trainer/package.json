{
  "name": "ai-trainer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "pre-commit": "lint-staged",
    "pre-commit-check": "./scripts/pre-commit-check.sh",
    "setup-hooks": "chmod +x setup-git-hooks.sh && ./setup-git-hooks.sh",
    "pre-check": "chmod +x scripts/local-checks.sh && ./scripts/local-checks.sh",
    "auto-fix": "chmod +x scripts/auto-fix.sh && ./scripts/auto-fix.sh",
    "pre-deploy": "chmod +x scripts/pre-deploy.sh && ./scripts/pre-deploy.sh",
    "export": "next build && next export"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.57.0",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/supabase-js": "^2.50.3",
    "@types/lodash": "^4.17.20",
    "chart.js": "^4.4.0",
    "lodash": "^4.17.21",
    "next": "15.3.5",
    "openai": "^4.28.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@ngrok/ngrok": "^1.5.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.5",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5"
  }
}
